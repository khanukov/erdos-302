Erdos302Lower.erdos302_lower_five_eighths_plus : Erdos302LowerConclusion
Erdos302Lower.erdos302_f302_lower_five_eighths_plus : Erdos302MaximumLowerConclusion
def Erdos302Lower.Erdos302MaximumLowerConclusion : Prop :=
∃ δ, 0 < δ ∧ ∃ N₀, ∀ N ≥ N₀, (5 / 8 + δ) * ↑N ≤ ↑(f302 N)
def Erdos302Lower.Erdos302LowerConclusion : Prop :=
∃ δ, 0 < δ ∧ ∃ N₀, ∀ N ≥ N₀, ∃ A ⊆ Finset.Icc 1 N, NoUnitFractionTriple A ∧ (5 / 8 + δ) * ↑N ≤ ↑A.card
