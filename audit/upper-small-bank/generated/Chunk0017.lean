    UpperBridge.OrderedCover ({121, 122, 14762} : Finset ℕ) S → 1 ≤ S.card := by
  apply UpperBank.ordered_sound (E := {{121, 122, 14762}})
  · decide
  · intro e he
    simp only [Finset.mem_insert, Finset.mem_singleton] at he
    subst e
    exact ⟨121, 122, 14762, by unfold UpperBridge.OrderedEdge; decide, rfl⟩
