theorem bank_node_266 : ∀ S : Finset ℕ,
    UpperBridge.OrderedCover ({462, 903, 946} : Finset ℕ) S → 1 ≤ S.card := by
  apply UpperBank.ordered_sound (E := {{462, 903, 946}})
  · decide
  · intro e he
    simp only [Finset.mem_insert, Finset.mem_singleton] at he
    subst e
    exact ⟨462, 903, 946, by unfold UpperBridge.OrderedEdge; decide, rfl⟩
