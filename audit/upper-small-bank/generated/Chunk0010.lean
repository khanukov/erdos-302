    UpperBridge.OrderedCover ({2583, 4264, 6552} : Finset ℕ) S → 1 ≤ S.card := by
  apply UpperBank.ordered_sound (E := {{2583, 4264, 6552}})
  · decide
  · intro e he
    simp only [Finset.mem_insert, Finset.mem_singleton] at he
    subst e
    exact ⟨2583, 4264, 6552, by unfold UpperBridge.OrderedEdge; decide, rfl⟩
