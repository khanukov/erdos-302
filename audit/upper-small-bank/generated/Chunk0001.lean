theorem bank_node_166 : ∀ S : Finset ℕ,
    UpperBridge.OrderedCover ({114, 150, 475} : Finset ℕ) S → 1 ≤ S.card := by
  apply UpperBank.ordered_sound (E := {{114, 150, 475}})
  · decide
  · intro e he
    simp only [Finset.mem_insert, Finset.mem_singleton] at he
    subst e
    exact ⟨114, 150, 475, by unfold UpperBridge.OrderedEdge; decide, rfl⟩
