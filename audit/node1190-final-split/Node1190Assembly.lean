/- These are the remaining bridges from the literal shard predicates to the
   generic checker's indexed predicates.  They are hypotheses, not proofs. -/
theorem leaf_with_index_bridges
    (hrows : ∀ i ∈ Finset.range entries.length,
      (BankCase.dualEntry entries i).1 ∈
        refs.map (MixedCaseTrimCandidate.row Node1209Dense.nodes 336))
    (hw : ∀ i ∈ Finset.range entries.length, 0 < (BankCase.dualEntry entries i).2)
    (hcap : ∀ x ∈ BankCase.Free (Node1209Dense.nodes 336).support ∅ ∅,
      (∑ i ∈ (Finset.range entries.length).filter
        (fun i => x ∈ (BankCase.dualEntry entries i).1.1),
        (BankCase.dualEntry entries i).2) ≤ (1000000 : ℤ))
    (hthreshold : (1000000 : ℤ) *
      (((Node1209Dense.nodes 336).demand : ℤ) - 1 - ((∅ : Finset ℕ).card : ℤ)) = 257000000)
    (hobjective : (∑ i ∈ Finset.range entries.length,
      (BankCase.dualEntry entries i).2 * BankCase.Remaining
        (BankCase.dualEntry entries i).1.1 (BankCase.dualEntry entries i).1.2 ∅) = objective) :
    BankCase.check (refs.map (MixedCaseTrimCandidate.row Node1209Dense.nodes 336))
      (Node1209Dense.nodes 336).support ∅ ∅ (Node1209Dense.nodes 336).demand
      (.dual entries 1000000) = true := by
  apply leaf_from_components
  · exact hrows
  · decide
  · exact hw
  · exact hcap
  · rw [hthreshold, hobjective, objective_exact]
    exact objective_bound
#print axioms leaf_with_index_bridges

